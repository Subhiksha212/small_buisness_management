# ====================================================================
# VERCEL DEPLOYMENT ENVIRONMENT VARIABLES CHECKLIST
# Add these key-value pairs into:
# Vercel Project Settings -> Environment Variables
# ====================================================================

# 1. CORE SERVER CONFIGURATION
NODE_ENV=production

# 2. MONGODB DATABASE (REQUIRED)
# IMPORTANT: Use a cloud MongoDB instance such as MongoDB Atlas.
# localhost:27017 will NOT work on Vercel serverless functions.
# Ensure Network Access in MongoDB Atlas allows IP '0.0.0.0/0' (Allow Access from Anywhere).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_business_db?retryWrites=true&w=majority

# 3. AUTHENTICATION & SECURITY (REQUIRED)
# Generate a strong 32+ character random string
JWT_SECRET=your_production_secure_jwt_secret_key_minimum_32_chars

# 4. FRONTEND API URL (OPTIONAL)
# If left unset, frontend automatically calls the same origin '/api'.
# If you wish to explicitly set it:
# VITE_API_URL=https://your-vercel-domain.vercel.app/api

# 5. PAYMENT GATEWAY (Razorpay - Optional / as needed)
PAYMENT_PROVIDER=Razorpay
PAYMENT_ENV=sandbox
PAYMENT_PROVIDER_KEY=rzp_test_your_sandbox_key_id
PAYMENT_PROVIDER_SECRET=your_sandbox_key_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret

# 6. SETU ACCOUNT AGGREGATOR (Optional / as needed)
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=your_setu_client_id
SETU_CLIENT_SECRET=your_setu_client_secret
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id
