# ====================================================================
# SMART BUSINESS MANAGER — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file or credentials to source control.
# ====================================================================

# 1. SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# 2. MONGODB DATABASE
# Local: mongodb://localhost:27017/smart_business_db
# Atlas: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/smart_business_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smart_business_db

# 3. AUTHENTICATION & SECURITY
# Set a strong, randomly generated string in production (at least 32 characters)
JWT_SECRET=your_secure_jwt_secret_key_minimum_32_characters

# 4. PAYMENT GATEWAY (Razorpay)
# Payment Provider: Razorpay | Sandbox
PAYMENT_PROVIDER=Razorpay

# Environment: 'sandbox' for test cards & UPI simulators | 'production' for live payments
# CRITICAL: Keep Sandbox and Production credentials separate. Never switch to production automatically.
PAYMENT_ENV=sandbox

# Sandbox / Test Credentials (rzp_test_...)
PAYMENT_PROVIDER_KEY=rzp_test_your_sandbox_key_id
PAYMENT_PROVIDER_SECRET=your_sandbox_key_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret_from_razorpay_dashboard

# Production / Live Credentials (rzp_live_...) — ONLY for live production deployment
# PAYMENT_PROVIDER_KEY=rzp_live_your_live_key_id
# PAYMENT_PROVIDER_SECRET=your_live_key_secret
# PAYMENT_WEBHOOK_SECRET=your_live_webhook_signing_secret

# 5. OPTIONAL AUTHORIZED BANK TRANSACTION FEED (Corporate Open-Banking API)
# Required only if your business bank provides an authorized corporate API / aggregator
# Direct personal bank account scraping is disallowed.
# BANK_FEED_ENABLED=false
# BANK_PROVIDER=none # e.g., ICICI_EazyPay, Decentro, Setu
# BANK_CLIENT_ID=your_bank_api_client_id
# BANK_CLIENT_SECRET=your_bank_api_client_secret
# BANK_ACCOUNT_NUMBER=your_corporate_account_number

# 6. SETU ACCOUNT AGGREGATOR (Sandbox FIU Gateway — Stage 1 & Stage 3)
# Official Docs: https://docs.setu.co/data/account-aggregator/quickstart
# Consent Flow: https://docs.setu.co/data/account-aggregator/api-integration/consent-flow
# Data APIs: https://docs.setu.co/data/account-aggregator/api-integration/data-apis
# Keep credentials strictly on backend. Sandbox base URL: https://fiu-sandbox.setu.co
SETU_BASE_URL=https://fiu-sandbox.setu.co
SETU_CLIENT_ID=your_setu_client_id_here
SETU_CLIENT_SECRET=your_setu_client_secret_here
SETU_PRODUCT_INSTANCE_ID=your_setu_product_instance_id_here
