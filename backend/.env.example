PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_business_db?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Payment Gateway Configuration (Secrets stay strictly in Backend!)
PAYMENT_PROVIDER=Razorpay # Options: Razorpay, Cashfree, Paytm, Sandbox
PAYMENT_ENV=sandbox # Options: sandbox, production
PAYMENT_PROVIDER_KEY=your_key_id_or_app_id
PAYMENT_PROVIDER_SECRET=your_key_secret_or_secret_key
PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret
